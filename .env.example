# Copy this file to .env and fill in the values. .env is gitignored and must never be committed.
# Any OpenAI-compatible endpoint serving the model works (for example a vLLM server).
LLM_BASE_URL=https://your-server.example/v1
LLM_API_KEY=your-key-here
# Optional: the notebook uses GLM-5.2 by default.
LLM_MODEL=GLM-5.2
